{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingfeed.dev/schemas/events/actor.action.performed.schema.json",
  "title": "ActorActionPerformed",
  "description": "액터의 확정 행동 — Tick RESOLVE 단계에서 적재된다 (ADR-011/012). decide의 구조화된 행동 의도가 충돌 해소를 통과한 결과다.",
  "type": "object",
  "properties": {
    "action_kind": {
      "type": "string",
      "description": "행동 분류 (speak, move, work, confront, help, ...)",
      "pattern": "^[a-z_]+$"
    },
    "intent": {
      "type": "string",
      "description": "행동 의도 한 줄 요약 (피드 내레이션 입력)",
      "maxLength": 500
    },
    "target_actor_id": {
      "type": ["string", "null"]
    },
    "location_id": {
      "type": ["string", "null"]
    },
    "params": {
      "type": "object",
      "description": "action_kind별 상세 파라미터"
    },
    "decision_trace": {
      "type": "object",
      "description": "감사 체인 (ADR-009 §3) — 결정 당시 컨텍스트 재조립용",
      "properties": {
        "trace_id": { "type": "string" },
        "tier": { "type": "string", "enum": ["hot", "warm", "cold_rule"] }
      },
      "required": ["trace_id", "tier"]
    }
  },
  "required": ["action_kind", "intent", "target_actor_id", "location_id", "params", "decision_trace"],
  "additionalProperties": false
}
