{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingfeed.dev/schemas/events/player.reaction.added.schema.json",
  "title": "PlayerReactionAdded",
  "description": "플레이어가 피드 포스트에 반응(좋아요)을 남겼다 (ADR-010 §WS 세션). 응답 의무는 없다 — 액터의 지각·감정 입력이 된다 (ADR-012/015: '좋아요 하나로도 세계는 당신을 알아차린다').",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "pattern": "^p_[a-z0-9_]+$"
    },
    "target_actor_id": {
      "type": "string",
      "description": "포스트 작성 액터"
    },
    "post_id": {
      "type": "string",
      "description": "반응이 달린 피드 포스트 (feed.post.published event_id)",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "type": "string",
      "enum": ["like"]
    }
  },
  "required": ["player_id", "target_actor_id", "post_id", "kind"],
  "additionalProperties": false
}
