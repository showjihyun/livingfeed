{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingfeed.dev/schemas/events/actor.emotion.shifted.schema.json",
  "title": "ActorEmotionShifted",
  "description": "액터 감정 상태의 유의미한 변화 (ADR-015). 변화가 임계 이상일 때만 발행된다 — mood는 PAD 3차원, emotions는 대상 있는 활성 감정 인스턴스 상위 목록. 원인은 봉투 causation_id가 가리킨다.",
  "type": "object",
  "properties": {
    "mood": {
      "type": "object",
      "description": "PAD 무드 벡터 — 느리게 변하고 baseline(성격)으로 회귀한다",
      "properties": {
        "pleasure": { "type": "number", "minimum": -1, "maximum": 1 },
        "arousal": { "type": "number", "minimum": -1, "maximum": 1 },
        "dominance": { "type": "number", "minimum": -1, "maximum": 1 }
      },
      "required": ["pleasure", "arousal", "dominance"],
      "additionalProperties": false
    },
    "emotions": {
      "type": "array",
      "description": "활성 감정 인스턴스 상위(강도순) — '화남'이 아니라 '누구 때문에 화남'",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z_]+$" },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "target_id": {
            "type": ["string", "null"],
            "description": "감정의 대상 (액터 또는 플레이어, 없으면 null)"
          }
        },
        "required": ["type", "intensity", "target_id"],
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string",
      "description": "사람이 읽는 한 줄 원인 요약 (디버깅·내레이션 입력)",
      "maxLength": 200
    }
  },
  "required": ["mood", "emotions", "reason"],
  "additionalProperties": false
}
