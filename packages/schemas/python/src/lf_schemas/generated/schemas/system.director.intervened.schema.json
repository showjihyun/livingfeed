{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingfeed.dev/schemas/events/system.director.intervened.schema.json",
  "title": "SystemDirectorIntervened",
  "description": "Director 개입의 감사 기록 (ADR-013 hard rule) — 모든 개입은 근거(발화 신호)와 함께 기록되어 서사가 감사 가능하다. 개입 산출물(예: world.incident.occurred)은 봉투 causation으로 이 이벤트를 가리킨다.",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string",
      "description": "사용한 개입 도구 — 화이트리스트가 전부다 (ADR-013)",
      "enum": [
        "inject_incident", "nudge_perception", "promote_actor",
        "set_season_theme", "boost_feed", "plan_arc"
      ]
    },
    "reason": {
      "type": "string",
      "description": "발화 근거 요약 — 어떤 신호가 임계를 넘었나",
      "minLength": 1,
      "maxLength": 300
    },
    "signals": {
      "type": "object",
      "description": "발화 시점 신호 스냅샷 (drama 이동평균, 침체 tick 수 등)",
      "properties": {
        "drama_ma": { "type": "number" },
        "quiet_ticks": { "type": "integer", "minimum": 0 },
        "tension_top": {
          "type": "array",
          "description": "그래프 긴장 상위 쌍 [from, to, resentment] (ADR-006 질의)",
          "items": { "type": "array" }
        }
      },
      "additionalProperties": true
    },
    "target_correlation_id": {
      "type": ["string", "null"],
      "description": "개입이 겨눈 서사 사슬 — 같은 사슬 연속 개입 금지의 근거"
    },
    "budget_remaining": {
      "type": "integer",
      "description": "이번 창(세계 1시간)에 남은 개입 예산",
      "minimum": 0
    }
  },
  "required": ["tool", "reason", "signals", "target_correlation_id", "budget_remaining"],
  "additionalProperties": false
}
