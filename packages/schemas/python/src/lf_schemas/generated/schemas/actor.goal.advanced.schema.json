{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingfeed.dev/schemas/events/actor.goal.advanced.schema.json",
  "title": "ActorGoalAdvanced",
  "description": "액터의 목표가 유의미하게 진행됐다 (ADR-012 §인지 루프 need/goal). 목표를 섬기는 행동이 누적돼 발행 임계를 넘을 때만 발행된다 — 사람은 한 걸음마다 '해냈다'고 선언하지 않는다. 진행은 기억 중요도(ADR-008 goal 항)와 서사(피드)의 재료다.",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "description": "페르소나 목표 식별자 (agents/personas goals[].id)",
      "pattern": "^[a-z0-9_]+$"
    },
    "description": {
      "type": "string",
      "description": "목표 서술 — 피드 내레이션·표시에 실린다",
      "minLength": 1,
      "maxLength": 200
    },
    "progress": {
      "type": "number",
      "description": "현재 진행도 0..1 (1이면 달성)",
      "minimum": 0,
      "maximum": 1
    },
    "need": {
      "type": "string",
      "description": "이 목표가 걸린 욕구 축 (achievement, belonging, security)",
      "pattern": "^[a-z_]+$"
    },
    "congruence": {
      "type": "number",
      "description": "정렬도 0..1 — 액터가 이 욕구를 얼마나 중히 여기는가 (needs_bias 유래)",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["goal_id", "description", "progress", "need", "congruence"],
  "additionalProperties": false
}
