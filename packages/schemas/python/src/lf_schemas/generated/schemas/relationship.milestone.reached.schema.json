{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingfeed.dev/schemas/events/relationship.milestone.reached.schema.json",
  "title": "RelationshipMilestoneReached",
  "description": "관계의 마일스톤 — 첫 만남, stage 전이, 배신 등 (ADR-016 §이력과 마일스톤). 에피소드 기억에 고중요도로 응고되고(ADR-008) Context Fabric의 관계 요약 재료가 된다. stage 전이는 수치가 아니라 이벤트가 만든다.",
  "type": "object",
  "properties": {
    "from_id": { "type": "string" },
    "to_id": { "type": "string" },
    "milestone": {
      "type": "string",
      "description": "마일스톤 종류 (first_met, stage_transition, betrayal, ...)",
      "pattern": "^[a-z_]+$"
    },
    "stage": {
      "type": "string",
      "description": "마일스톤 이후의 stage",
      "enum": [
        "stranger", "acquaintance", "friend", "close_friend",
        "romantic", "family", "mentor", "rival", "enemy"
      ]
    },
    "note": {
      "type": "string",
      "description": "관계 요약 문장의 재료 — '어쩌다 이렇게 됐는지'의 한 줄",
      "maxLength": 200
    }
  },
  "required": ["from_id", "to_id", "milestone", "stage", "note"],
  "additionalProperties": false
}
