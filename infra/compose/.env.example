# infra/compose/.env 로 복사 후 수정 (선택 — 기본값으로도 동작한다)
# 전부 개발 전용 자격증명이다. staging/prod는 Helm values + secret으로 관리 (ADR-019).

POSTGRES_USER=livingfeed
POSTGRES_PASSWORD=livingfeed
POSTGRES_DB=livingfeed

# 호스트 포트 재정의 (기본값과 충돌할 때만)
#POSTGRES_PORT=5433
#REDIS_PORT=6380

MINIO_ROOT_USER=livingfeed
MINIO_ROOT_PASSWORD=livingfeed
